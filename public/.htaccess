# Hostinger (Apache/LiteSpeed): página própria para endereços que não existem.
ErrorDocument 404 /404.html
DirectoryIndex index.html index.php

# Um endereço só para o Google: quem abrir sem "www" vai para o endereço com "www" (o oficial).
# Só o domínio principal é redirecionado; subdomínios (como escalas.) não são afetados.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^igrejacongregacionalpombal\.com\.br$ [NC]
  RewriteRule ^ https://www.igrejacongregacionalpombal.com.br%{REQUEST_URI} [L,R=301]
</IfModule>

# A página "Ministérios" passou a se chamar "Departamentos".
Redirect 301 /ministerios/ /departamentos/

# Páginas: o navegador sempre confere se há versão nova antes de usar a cópia guardada,
# para que cada publicação apareça para os visitantes sem precisar limpar o cache.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
