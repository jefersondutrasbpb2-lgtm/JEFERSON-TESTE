# Domínio oficial do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# Subdiretório de hospedagem, se houver (ex.: /site). Deixe vazio na raiz do domínio.
NEXT_PUBLIC_BASE_PATH=

# Endpoints que recebem os formulários via POST JSON (ex.: https://formspree.io/f/xxxxxxx)
NEXT_PUBLIC_CONTACT_ENDPOINT=
NEXT_PUBLIC_PRAYER_ENDPOINT=

# Feed do Instagram do projeto O Bom Samaritano (@obom.samaritano) — use UMA das opções
# URL de feed JSON (ex.: Behold): https://feeds.behold.so/XXXXXXXX
IG_FEED_BOM_SAMARITANO=
# Token da API do Instagram (Instagram Login)
IG_TOKEN_BOM_SAMARITANO=
